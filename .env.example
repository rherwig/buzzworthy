# Copy to `.env` and adjust. Validated at boot by server/utils/env.ts (Zod).

# Dev: SQLite file, relative to prisma/. Prod: swap to a PostgreSQL URL, e.g.
#   DATABASE_URL="postgresql://user:pass@localhost:5432/app?schema=public"
#
# A relative SQLite path only works with the Prisma schema next to it. In a production
# build the schema is not shipped, so use an ABSOLUTE path there (the deployed default is
# file:/data/buzzworthy.db) — see docs/DEPLOY.md.
DATABASE_URL="file:./dev.db"

# Node environment: development | test | production
NODE_ENV="development"
