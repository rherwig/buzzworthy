# Copy to `.env` and adjust. Validated at boot by server/utils/env.ts (Zod).

# Dev: SQLite file. Prod: swap to a PostgreSQL URL, e.g.
#   DATABASE_URL="postgresql://user:pass@localhost:5432/app?schema=public"
DATABASE_URL="file:./dev.db"

# Node environment: development | test | production
NODE_ENV="development"
